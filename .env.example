# ============================================================
# MANYA — environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`.
# ============================================================

# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
DJANGO_ALLOWED_HOSTS=*
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Leave unset to use SQLite (db.sqlite3) for local development.
DATABASE_URL=

# Africa's Talking (https://account.africastalking.com)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USSD_SHORTCODE=
AFRICASTALKING_VOICE_NUMBER=
# Set to "sandbox" to use the AT sandbox API (recommended during development).
AFRICASTALKING_ENVIRONMENT=sandbox

# Sunbird AI translation (https://api.sunbird.ai — Bearer token from /auth/token)
SUNBIRD_API_TOKEN=
SUNBIRD_BASE_URL=https://api.sunbird.ai
# Set to true to automatically translate missing content via Sunbird.
# When disabled (default), untranslated content falls back to English.
SUNBIRD_ENABLED=false
# Seconds allowed for a Sunbird translation request before it times out.
SUNBIRD_TIMEOUT=10

# Frontend (Vite)
# Where the browser reaches the Django API.
VITE_API_BASE_URL=http://localhost:8000/api